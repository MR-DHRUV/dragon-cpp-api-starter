{
  "version": 3,
  "configurePresets": [
    {
      "name": "x64-release",
      "displayName": "x64 Release (vcpkg + MSVC)",
      "description": "Release build with optimizations enabled",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/x64-release",
      "cmakeExecutable": "cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug (vcpkg + MSVC)",
      "description": "Debug build with symbols and assertions",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/x64-debug",
      "cmakeExecutable": "cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-release",
      "configurePreset": "x64-release"
    },
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug"
    }
  ]
}
